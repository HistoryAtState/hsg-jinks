{
  "theme" : {
    "banner" : true,
    "identifier" : {
      "enabled" : false
    },
    "colors" : {
      "palette" : "navy"
    },
    "landing" : {
      "hero" : {
        "background-image" : "../images/hero.jpg",
        "background-size" : "cover",
        "background-position" : "center",
        "background-repeat" : "no-repeat",
        "height" : "25rem",
        "label" : "Bound volumes of the Foreign Relations of the United States series on a shelf"
      }
    },
    "logo" : {
      "image" : "oh-logo.png",
      "width" : "1280px",
      "height" : "141px"
    },
    "footer" : {
      "$replace" : [
        "columns",
        "social",
        "required-links"
      ],
      "class" : "hsg-footer",
      "return-to-top" : true,
      "columns" : [
        {
          "heading" : "Learn more",
          "links" : [
            {
              "label" : "Home",
              "url" : ""
            },
            {
              "label" : "Search",
              "url" : "search"
            },
            {
              "label" : "About Us",
              "url" : "about"
            },
            {
              "label" : "Contact Us",
              "url" : "about/contact-us"
            },
            {
              "label" : "FAQ",
              "url" : "about/faq"
            }
          ]
        },
        {
          "heading" : "Topics",
          "links" : [
            {
              "label" : "Historical Documents",
              "url" : "historicaldocuments"
            },
            {
              "label" : "Department History",
              "url" : "departmenthistory"
            },
            {
              "label" : "Countries",
              "url" : "countries"
            }
          ]
        }
      ],
      "contact" : {
        "heading" : "Contact",
        "phone" : "202-955-0200",
        "email" : "history@state.gov"
      },
      "social" : [
        {
          "label" : "X",
          "icon" : "x.svg",
          "url" : "https://x.com/HistoryAtState"
        },
        {
          "label" : "GitHub",
          "icon" : "github.svg",
          "url" : "https://github.com/HistoryAtState"
        }
      ],
      "required-links" : [
        {
          "label" : "Accessibility Statement",
          "url" : "https://www.state.gov/section-508-accessibility-statement/"
        },
        {
          "label" : "Privacy Policy",
          "url" : "https://www.state.gov/privacy-policy/"
        },
        {
          "label" : "External Link Policy",
          "url" : "https://www.state.gov/external-link-policy-and-disclaimers/"
        },
        {
          "label" : "Copyright Information",
          "url" : "https://www.state.gov/copyright-information/"
        },
        {
          "label" : "Content Warning",
          "url" : "about/content-warning"
        }
      ],
      "agency" : {
        "name" : "Office of the Historian, Shared Knowledge Services, Bureau of Administration",
        "parent" : {
          "label" : "United States Department of State",
          "url" : "https://www.state.gov"
        }
      }
    }
  },
  "label" : "hsg-jinks",
  "odds" : [
    "hsg-jinks.odd"
  ],
  "id" : "https://e-editiones.org/apps/hsg-jinks",
  "data" : {
    "landing" : "/db/apps/hsg-jinks/data/landing/landing.xml"
  },
  "defaults" : {
    "browse" : "historicaldocuments",
    "data" : "/db/apps/frus-data-jinks/data",
    "data-default" : "frus-v2-data",
    "odd" : "hsg-jinks.odd",
    "template" : "volume-landing.html",
    "$replace" : [
      "languages"
    ],
    "languages" : [
      "en"
    ]
  },
  "features" : {
    "toolbar" : {
      "enabled" : true,
      "navigation" : false,
      "zoom" : false
    }
  },
  "menu" : {
    "login" : false,
    "language" : false,
    "$replace" : [
      "items"
    ],
    "items" : [
      { "id" : "home", "url" : "" },
      { "id" : "historicaldocuments", "subitems" : [
        { "id" : "frus", "url" : "historicaldocuments" },
        { "id" : "about-frus", "url" : "historicaldocuments/about-frus" },
        { "id" : "status-of-the-series", "url" : "historicaldocuments/status-of-the-series" },
        { "id" : "frus-history", "url" : "historicaldocuments/frus-history" },
        { "id" : "ebooks", "url" : "historicaldocuments/ebooks" },
        { "id" : "quarterly-releases", "url" : "historicaldocuments/quarterly-releases" }
      ] },
      { "id" : "departmenthistory", "subitems" : [
        { "id" : "dh-overview", "url" : "departmenthistory" },
        { "id" : "secretaries", "url" : "departmenthistory/people/secretaries" },
        { "id" : "principals-chiefs", "url" : "departmenthistory/people/principals-chiefs" },
        { "id" : "travels-secretary", "url" : "departmenthistory/travels/secretary" },
        { "id" : "travels-president", "url" : "departmenthistory/travels/president" },
        { "id" : "visits", "url" : "departmenthistory/visits" },
        { "id" : "wwi", "url" : "departmenthistory/wwi" },
        { "id" : "buildings", "url" : "departmenthistory/buildings" },
        { "id" : "diplomatic-couriers", "url" : "departmenthistory/diplomatic-couriers" },
        { "id" : "marine-corps", "url" : "departmenthistory/marine-corps" }
      ] },
      { "id" : "countries", "subitems" : [
        { "id" : "countries-recognition", "url" : "countries" },
        { "id" : "archives", "url" : "countries/archives" }
      ] },
      { "id" : "resources", "subitems" : [
        { "id" : "tags", "url" : "tags" },
        { "id" : "conferences", "url" : "conferences" },
        { "id" : "contact-us", "url" : "about/contact-us" },
        { "id" : "developer", "url" : "developer" },
        { "id" : "education", "url" : "education" },
        { "id" : "faq", "url" : "about/faq" },
        { "id" : "milestones", "url" : "milestones" },
        { "id" : "open", "url" : "open" },
        { "id" : "short-history", "url" : "departmenthistory/short-history" }
      ] },
      { "id" : "about", "url" : "about" }
    ]
  },
  "$schema" : "../jinks/schema/jinks.json",
  "styles" : [
    "resources/css/hsg-theme.css",
    "resources/css/frus-renditions.css"
  ],
  "script" : {
    "custom" : [
      "resources/scripts/nav-active.js",
      "resources/scripts/search-query.js"
    ]
  },
  "api" : [
    {
      "spec" : "hsg-api.json",
      "prefix" : "hsgapi",
      "id" : "http://teipublisher.com/api/hsg",
      "path" : "hsg-api.xql"
    },
    {
      "spec" : "countries-api.json",
      "prefix" : "countryapi",
      "id" : "http://teipublisher.com/api/countries",
      "path" : "countries-api.xql"
    },
    {
      "spec" : "departmenthistory-api.json",
      "prefix" : "dhapi",
      "id" : "http://teipublisher.com/api/departmenthistory",
      "path" : "departmenthistory-api.xql"
    },
    {
      "spec" : "about-api.json",
      "prefix" : "aboutapi",
      "id" : "http://teipublisher.com/api/about",
      "path" : "about-api.xql"
    },
    {
      "spec" : "tags-api.json",
      "prefix" : "tagapi",
      "id" : "http://teipublisher.com/api/tags",
      "path" : "tags-api.xql"
    },
    {
      "spec" : "milestones-api.json",
      "prefix" : "milapi",
      "id" : "http://teipublisher.com/api/milestones",
      "path" : "milestones-api.xql"
    },
    {
      "spec" : "search-api.json",
      "prefix" : "searchapi",
      "id" : "https://history.state.gov/api/search",
      "path" : "search-api.xql"
    },
    {
      "spec" : "developer-api.json",
      "prefix" : "devapi",
      "id" : "http://teipublisher.com/api/developer",
      "path" : "developer-api.xql"
    },
    {
      "spec" : "education-api.json",
      "prefix" : "eduapi",
      "id" : "http://teipublisher.com/api/education",
      "path" : "education-api.xql"
    },
    {
      "spec" : "conferences-api.json",
      "prefix" : "confapi",
      "id" : "http://teipublisher.com/api/conferences",
      "path" : "conferences-api.xql"
    },
    {
      "spec" : "opengov-api.json",
      "prefix" : "ogapi",
      "id" : "http://teipublisher.com/api/open",
      "path" : "opengov-api.xql"
    },
    {
      "prefix" : "hsg-errors",
      "id" : "https://history.state.gov/ns/site/hsg/errors",
      "path" : "hsg-errors.xqm"
    },
    {
      "spec" : "services-api.json",
      "prefix" : "servicesapi",
      "id" : "https://history.state.gov/api/services",
      "path" : "services-api.xql"
    },
    {
      "spec" : "menu-api.json",
      "prefix" : "menuapi",
      "id" : "https://history.state.gov/api/menu",
      "path" : "menu-api.xql"
    },
    {
      "spec" : "opds-catalog-api.json",
      "prefix" : "opdsapi",
      "id" : "http://teipublisher.com/api/opds",
      "path" : "opds-catalog-api.xql"
    }
  ],
  "extends" : [
    "base10",
    "landing-page",
    "docker",
    "profile-theme-uswds"
  ],
  "skip" : [
    "^templates/browse\\.html$",
    "^data/landing/landing\\.xml",
    "^resources/images/team/",
    "^resources/images/hero\\.(jpg|webp)$",
    "^resources/images/(typewriter[12]|books|header-bg|paper-texture)\\.jpg",
    "^resources/images/type\\.jpeg",
    "^resources/images/gplv3-rounded-grey-180x60\\.jpg",
    "^resources/images/(tei-with-text|e-editiones-logo-color|jinntec|tei-publisher-logo-color|arrow-right)\\.svg",
    "^resources/scripts/header\\.js",
    "^resources/i18n/app/en\\.json",
    "^templates/menu\\.html",
    "^templates/menu-mobile\\.html",
    "^test/cypress/e2e/gui/landing-page\\.cy\\.js",
    "^test/cypress/e2e/[^/]+\\.cy\\.js$",
    "^templates/footer\\.html",
    "^modules/lib/api\\.json",
    "^data/content/"
  ],
  "ignore" : [
    "^modules/lib/api\\.xql"
  ],
  "templating" : {
    "use" : [
      "templates/hsg-blocks.html"
    ],
    "modules" : {
      "http://history.state.gov/ns/templates/landing" : {
        "prefix" : "hsg-landing",
        "at" : "modules/templates/hsg-landing.xqm"
      },
      "https://history.state.gov/ns/templates/hsg" : {
        "prefix" : "hsg",
        "at" : "modules/templates/hsg.xqm"
      }
    }
  },
  "pkg" : {
    "abbrev" : "hsg-jinks"
  },
  "description" : "Office of the Historian"
}
