            "get": {
                "summary": "Department History section landing page",
                "operationId": "dhapi:index",
                "x-error-handler": "dhapi:handle-error",
                "tags": [ "departmenthistory" ],
                "responses": {
                    "200": {
                        "description": "HTML of the page",
                        "content": { "text/html": { "schema": { "type": "string" } } }
                    }
                }
            }
        },
