            {
              "label" : "Historical Documents",
              "url" : "historicaldocuments"
            },
            {
              "label" : "Department History",
              "url" : "departmenthistory"
            },
            {
              "label" : "Countries",
              "url" : "https://history.state.gov/countries/"
            }
          ]
        }
      ],
      "contact" : {
        "heading" : "Contact",
        "phone" : "202-955-0200",
        "email" : "history@state.gov"
      },
      "social" : [
        {
          "label" : "X",
          "icon" : "x.svg",
          "url" : "https://x.com/HistoryAtState"
