            <sourceDesc>
                <p>Generated by <ref target="http://tei-publisher.org">TEI Publisher</ref>
                </p>
                <p>born digital</p>
            </sourceDesc>
        </fileDesc><encodingDesc><tagsDecl/></encodingDesc><revisionDesc>
            <change when="2025-11-10T19:08:27.185+01:00">Initial version</change>
        </revisionDesc></teiHeader><text>
        <body>
            <schemaSpec start="TEI teiCorpus" source="teipublisher.odd"> <elementSpec ident="div" mode="change"><model predicate="$parameters?mode=('volume-landing', 'volume-interior')" behaviour="block"/><model predicate="$parameters?mode = 'register'" behaviour="pass-through">
            <desc>Output register data if register profile is enabled</desc>
            <param name="people" value="let $refs := (root(.)//persName[@key or @ref], root(.)//rs[@type='person'][@key or @ref]) let $keys := for $i in ($refs/@key, $refs/@ref) return $i ! tokenize(., ' ')  for $key in distinct-values($keys) return collection($global:register-root)/id($key)[self::person]"/>
            <param name="places" value="let $refs := (root(.)//placeName[@key or @ref], root(.)//rs[@type='place'][@key or @ref]) let $keys := for $i in ($refs/@key, $refs/@ref) return $i ! tokenize(., ' ')  for $key in distinct-values($keys) return collection($global:register-root)/id($key)[self::place]"/>
            <pb:template xml:space="preserve"><div xmlns="" class="register">
<h3><pb-i18n key="register-details.people">ppl</pb-i18n></h3>
<ul>
[[people]]
</ul>

<h3><pb-i18n key="register-details.places">pl</pb-i18n></h3>
<ul>
[[places]]
</ul>
</div></pb:template>
        </model><model predicate="parent::body or parent::front or parent::back" behaviour="section"/><model behaviour="block"/></elementSpec>
                <elementSpec ident="xi:include" mode="change"><model predicate="$parameters?mode='volume-landing'" behaviour="listItem" pb:mode="interior">
            <desc>Process xincludes on a landing page</desc>
            <param name="content" value="id(@xpointer, doc(util:collection-name(.) || '/' || @href))/ancestor::TEI//titleStmt/title"/>
        </model><model predicate="$parameters?mode='volume-interior'" behaviour="listItem" pb:mode="document">
            <desc>Process xincludes on an interior page</desc>
            <param name="content" value="id(@xpointer, doc(util:collection-name(.) || '/' || @href))/ancestor::TEI//titleStmt/title"/>
        </model><model predicate="$parameters?mode='document-view'" behaviour="pass-through">
            <desc>Inline an xincluded attachment into its parent document. Documents include their attachments into text/back, and pass-through emits no wrapper, so handing the attachment's TEI root back to the document-view models lets the attachment-label model above render it in place.</desc>
            <param name="content" value="id(@xpointer, doc(util:collection-name(.) || '/' || @href))/ancestor-or-self::TEI"/>
        </model></elementSpec>
            <elementSpec ident="TEI" mode="change"><model predicate="$parameters?mode=('volume-landing', 'volume-interior')" behaviour="block">
            <param name="content" value="./text/body//xi:include"/>
            <param name="head" value=".//fileDesc//titleStmt/title"/>
            <pb:template xml:space="preserve"><div xmlns="">
  [[head]]
  <ul>
    [[content]]
  </ul>
</div></pb:template>
        </model><model predicate="$parameters?mode='metadata-panel'" behaviour="pass-through">
            <param name="content" value="teiHeader"/>
        </model><model predicate="$parameters?mode='edition-navigation' and descendant::correspContext" behaviour="pass-through">
            <desc>process correspContext to provide in-edition navigation buttons to move between documents</desc>
            <param name="content" value="descendant::correspContext"/>
        </model><model predicate="$parameters?mode = 'register'" behaviour="pass-through">
            <desc>Output register data if register profile is enabled</desc>
            <param name="people" value="for $key in distinct-values((root(.)//persName/@key, root(.)//persName/@ref)) return collection($global:register-root)/id($key)[self::person]"/>
            <param name="places" value="for $key in distinct-values((root(.)//placeName/@key, root(.)//placeName/@ref)) return collection($global:register-root)/id($key)[self::place]"/>
            <pb:template xml:space="preserve"><div xmlns="" class="register">
<h3>People</h3>
<ul>
[[people]]
</ul>

<h3>Places</h3>
<ul>
[[places]]
</ul>
</div></pb:template>
        </model><model predicate="$parameters?mode='document-view' and normalize-space(.//bibl[@type='frus-attachment-label']) != ''" behaviour="block">
            <desc>An attachment ("Tab I") inlined into its parent document, as the reference site renders it. It carries no overline and no footnote list of its own: its notes are merged into the parent's consolidated list, which is why their @n continue the parent's sequence. It has no document number either - its frus-document-number bibl is present but empty.</desc>
            <param name="label" value=".//bibl[@type='frus-attachment-label']"/>
            <param name="head" value=".//fileDesc//titleStmt/title"/>
            <param name="srcId" value="substring-after((.//standOff//note[@type='source'])[1]/@corresp, '#')"/>
            <param name="srcRef" value="substring-after((.//standOff//note[@type='source'])[1]/@corresp, '#') || 'ref'"/>
            <param name="srcLabel" value="(.//standOff//note[@type='source'])[1]/@n/string()"/>
            <param name="dateline" value=".//profileDesc//setting"/>
            <param name="content" value="text/body"/>
            <pb:template xml:space="preserve"><div xmlns="" class="attachment">
  <hr class="attachment-divider"/>
  <h2 class="attachment-label">[[label]]</h2>
  <h3 class="attachment-title">[[head]]<sup class="footnote-ref"><a id="[[srcRef]]" href="#[[srcId]]">[[srcLabel]]</a></sup></h3>
  [[dateline]]
  [[content]]
</div></pb:template>
        </model><model predicate="$parameters?mode='document-view' and exists(.//standOff//note)" behaviour="block">
            <desc>A document with footnotes (333 of 341). The heading's marker points at the source note, which has no in-body anchor - it belongs to the heading. Its label comes from the note's @n and must not be hardcoded to 1: attachment notes continue their parent's numbering. Footnotes are consolidated from this document and any inlined attachments, ordered by @n.</desc>
            <param name="overline" value="let $volid := root(.)//bibl[@type='frus-volume-id']/string() let $volcol := substring-before(document-uri(root(.)), '/' || $volid || '/') || '/' || $volid return doc($volcol || '/' || $volid || '.xml')//seriesStmt/title[@type='complete']"/>
            <param name="number" value=".//bibl[@type='frus-document-number']"/>
            <param name="head" value=".//fileDesc//titleStmt/title"/>
            <param name="srcId" value="substring-after((.//standOff//note[@type='source'])[1]/@corresp, '#')"/>
            <param name="srcRef" value="substring-after((.//standOff//note[@type='source'])[1]/@corresp, '#') || 'ref'"/>
            <param name="srcLabel" value="(.//standOff//note[@type='source'])[1]/@n/string()"/>
            <param name="dateline" value=".//profileDesc//setting"/>
            <param name="content" value="text/body"/>
            <param name="attachments" value="text/back/xi:include"/>
            <param name="footnotes" value="let $att := (text/back/xi:include ! (id(@xpointer, doc(util:collection-name(.) || '/' || @href))/root()//standOff//note)) return (for $note in (.//standOff//note, $att) order by number($note/@n) return $note)"/>
            <pb:template xml:space="preserve"><div xmlns="">
  <p class="overline">[[overline]]</p>
  <h1>[[number]]. [[head]]<sup class="footnote-ref"><a id="[[srcRef]]" href="#[[srcId]]">[[srcLabel]]</a></sup></h1>
  [[dateline]]
  [[content]]
  [[attachments]]
  <hr class="footnotes-divider"/>
  <ol class="footnotes">[[footnotes]]</ol>
</div></pb:template>
        </model><model predicate="$parameters?mode='document-view'" behaviour="block">
            <desc>A document without footnotes (8 of 341: 7 editorial notes and 1 historical document). No source note exists, so the heading carries no marker and no ruler or footnote list is emitted. None of these documents have attachments.</desc>
            <param name="overline" value="let $volid := root(.)//bibl[@type='frus-volume-id']/string() let $volcol := substring-before(document-uri(root(.)), '/' || $volid || '/') || '/' || $volid return doc($volcol || '/' || $volid || '.xml')//seriesStmt/title[@type='complete']"/>
            <param name="number" value=".//bibl[@type='frus-document-number']"/>
            <param name="head" value=".//fileDesc//titleStmt/title"/>
            <param name="dateline" value=".//profileDesc//setting"/>
            <param name="content" value="text/body"/>
            <pb:template xml:space="preserve"><div xmlns="">
  <p class="overline">[[overline]]</p>
  <h1>[[number]]. [[head]]</h1>
  [[dateline]]
  [[content]]
</div></pb:template>
        </model><model predicate="$parameters?mode='division'" behaviour="pass-through">
            <desc>Render a division document's text content without the HTML document skeleton, so it can be embedded in a page's main element</desc>
            <param name="content" value="text/body"/>
        </model><model behaviour="document"/></elementSpec>
            <elementSpec ident="title" mode="change"><model predicate="$mode='interior'" behaviour="link">
            <desc>Coming from a landing page, list interior pages</desc>
            <param name="uri" value="root(.)//bibl[@type='frus-volume-id'] || '/' || root(.)//bibl[@type='frus-division-id']"/>
        </model><model predicate="$mode='document'" behaviour="link">
            <desc>Coming from an interior page, list documents</desc>
            <param name="uri" value="root(.)//bibl[@type='frus-division-id']"/>
        </model><model predicate="$parameters?mode=('volume-landing', 'volume-interior')" behaviour="heading"/><model predicate="$parameters?mode='metadata-panel'" behaviour="block"/><model predicate="$parameters?mode='register-details' and $parameters?static" behaviour="link">
            <param name="uri" value="$parameters?context-path || &#34;/letters/&#34; || util:document-name(.) || '/1/index.html'"/>
            <param name="content" value="string()"/>
        </model><model predicate="$parameters?mode='register-details'" behaviour="link">
            <desc>create a link to the document, respecting address-by-id configuration</desc>
            <param name="content" value="string()"/>
            <param name="uri" value="if ($global:address-by-id) then                             '../' || root(.)/descendant-or-self::TEI/@xml:id                                                      else                                 '../' || substring-after(document-uri(root(.)), $global:data-root || '/')"/>
        </model><model predicate="$parameters?display='browse'" behaviour="heading">
            <param name="level" value="5"/>
        </model><model predicate="@key or @ref" behaviour="alternate">
            <param name="alternate" value="let $key:= head((@key, @ref))  return collection($global:register-root)/id($key)"/>
            <param name="default" value="."/>
        </model><model behaviour="inline"/></elementSpec>
            <elementSpec ident="date" mode="change"><model predicate="$parameters?mode='document-view'" behaviour="inline">
            <desc>In a dateline, render the date as the encoding has it. Without this, the @when model below wins and renders the date twice - once as text and once reformatted ("March 11, 1985" followed by "11th March 1985") - because alternate emits both.</desc>
        </model><model predicate="$parameters?display='browse' or $parameters?mode=('breadcrumb', 'title')" behaviour="inline"/><model predicate="@when" behaviour="alternate">
                        <param name="default" value="if (normalize-space(.)) then . else @when/string()"/>
                        <param name="alternate" value="try { format-date(xs:date(@when), '[D1o] [MNn] [Y]', ($parameters?language, 'en')[1], (), ()) } catch * { @when/string() }"/>
                    </model><model behaviour="inline"/></elementSpec>
            <elementSpec ident="setting" mode="add"><model predicate="$parameters?mode='document-view' and placeName[normalize-space(.) != ''] and date[normalize-space(.) != '']" behaviour="block">
            <desc>Dateline, place and date (327 of 341 documents). The comma is supplied here: the encoding has no separator between placeName and date.</desc>
            <param name="place" value="placeName"/>
            <param name="date" value="date[normalize-space(.) != ''][1]"/>
            <pb:template xml:space="preserve"><p xmlns="" class="dateline">[[place]], [[date]]</p></pb:template>
        </model><model predicate="$parameters?mode='document-view' and date[normalize-space(.) != '']" behaviour="block">
            <desc>Dateline, date only (4 documents, e.g. d299, d125-a1) - no comma, since there is no place to separate it from.</desc>
            <param name="date" value="date[normalize-space(.) != ''][1]"/>
            <pb:template xml:space="preserve"><p xmlns="" class="dateline">[[date]]</p></pb:template>
        </model><model predicate="$parameters?mode='document-view'" behaviour="omit">
            <desc>No dateline (10 documents, e.g. d304 and the appendices). The setting element is always present but is empty for these, so render nothing rather than an empty line.</desc>
        </model></elementSpec>
            <elementSpec ident="anchor" mode="change"><model predicate="$parameters?mode='document-view' and @xml:id" behaviour="pass-through">
            <desc>FRUS footnote marker. The note points at the anchor (note/@corresp = '#' || anchor/@xml:id), the reverse of the base models below, which expect the anchor to point at the note - so those never match FRUS data and the marker fell through to the bare anchor model, rendering an empty span. Every in-body anchor in the corpus resolves to a note, so no fallback is needed.</desc>
            <param name="noteId" value="@xml:id/string()"/>
            <param name="refId" value="@xml:id || 'ref'"/>
            <param name="label" value="let $target := '#' || @xml:id return root(.)//standOff//note[@corresp = $target]/@n/string()"/>
            <pb:template xml:space="preserve"><sup xmlns="" class="footnote-ref"><a id="[[refId]]" href="#[[noteId]]">[[label]]</a></sup></pb:template>
        </model><model predicate="$parameters?mode=('toc', 'breadcrumb')" behaviour="omit"/><model predicate="@corresp" behaviour="note">
            <desc>Process notes with corresp attribute (assuming the note is stand off,
                            somewhere in the same document)</desc>
            <param name="content" value="let $target := @corresp return root($parameters?root)/id($target)/node()"/>
            <param name="label" value="@n"/>
        </model><model predicate="@type='note'" behaviour="note">
            <desc>Process notes with @type=note (assuming the note is stand off,
                            in the listAnnotation section in the same document)</desc>
            <param name="content" value="let $target := '#' || @xml:id return root($parameters?root)//listAnnotation/note[@target=$target]/node()"/>
            <param name="label" value="let $target := '#' || @xml:id return root($parameters?root)//listAnnotation/note[@target=$target]/@n/string()"/>
        </model><model predicate="@xml:id" behaviour="anchor">
            <param name="id" value="@xml:id"/>
        </model></elementSpec>
            <elementSpec ident="note" mode="change"><model predicate="$parameters?mode='document-view' and ancestor::listAnnotation" behaviour="pass-through">
            <desc>FRUS footnote, rendered as an item of the document's consolidated list. @value carries the encoded number rather than relying on the ol's own counter, because an inlined attachment's notes continue the parent's sequence and so do not start at 1. The source note has no in-body anchor, so its backlink targets the marker on the heading.</desc>
            <param name="n" value="@n/string()"/>
            <param name="noteId" value="substring-after(@corresp, '#')"/>
            <param name="refId" value="substring-after(@corresp, '#') || 'ref'"/>
            <param name="content" value="node()"/>
            <pb:template xml:space="preserve"><li xmlns="" id="[[noteId]]" value="[[n]]">[[content]] <a class="footnote-backlink" href="#[[refId]]" aria-label="Back to content">↩</a></li></pb:template>
        </model><model predicate="$parameters?mode='register-overview' and $parameters?show-notes and text()" behaviour="block">
            <desc>When show-notes parameter is set, display note in register overview (index)</desc>
        </model><model predicate="$parameters?mode='register-overview' and not($parameters?show-notes)" behaviour="omit">
            <desc>Omit notes in register overview (index) When show-notes parameter is not set</desc>
        </model><model predicate="parent::person or parent::place or parent::org" behaviour="paragraph"/><model predicate="$parameters?mode='toc' or ancestor::listAnnotation" behaviour="omit"/><model behaviour="note">
            <param name="place" value="@place"/>
            <param name="label" value="@n"/>
        </model></elementSpec>
            <elementSpec ident="teiHeader" mode="change"><model output="latex" behaviour="metadata"/><model output="fo" behaviour="omit"/><model predicate="$parameters?mode='metadata-panel'" behaviour="pass-through"/><model predicate="$parameters?display='browse'" behaviour="block"/><model behaviour="metadata"/></elementSpec></schemaSpec>
        </body>
    </text></TEI>