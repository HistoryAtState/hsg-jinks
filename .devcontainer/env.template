# Per-worktree devcontainer settings. Copy to .devcontainer/.env (gitignored)
# -- tools/new-worktree.sh writes it for you. Compose auto-loads it from this
# directory; nothing here may be committed.
#
# Host-side ports only: eXist always listens on 8080/8443 inside the container.
HSG_HTTP_PORT=8090
HSG_HTTPS_PORT=8453
# Unique per worktree -- names the compose project (container/network prefix).
COMPOSE_PROJECT_NAME=hsg-jinks--main
# Optional: JVM max RAM percentage; lower it when running several instances.
#HSG_JVM_RAM=50.0
