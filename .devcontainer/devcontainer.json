{
    "name": "hsg-jinks",
    // Compose-based so per-worktree host ports and the compose project name
    // come from the gitignored .devcontainer/.env (see env.template and the
    // README section "Parallel worktrees"). The checked-in devcontainer files
    // stay byte-identical in every worktree; never put machine-specific
    // values here.
    "dockerComposeFile": "docker-compose.yml",
    "service": "existdb",
    // Fixed folder name (not the worktree's basename) so postCreateCommand
    // and in-container tooling see the same path in every worktree.
    "workspaceFolder": "/workspaces/hsg-jinks",
    "customizations": {
        "vscode": {
            "extensions": [ "exist-db.existdb-vscode", "42crunch.vscode-openapi", "redhat.vscode-xml" ]
        }
    },
    "overrideCommand": false,
    "postCreateCommand": [
        "${containerWorkspaceFolder}/.devcontainer/init.sh"
    ]
}
