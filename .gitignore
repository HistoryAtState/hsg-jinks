.DS_Store

# local eXist connection config for xst (host port remap, credentials)
.env
.xstrc

# xar built from the private profile-theme-uswds checkout, copied in for the
# devcontainer build (see .devcontainer/Dockerfile.dev)
.devcontainer/*.xar
# frus-data-jinks xar staged at the repo root for the production Docker image
# build (see Dockerfile) -- a build artifact of the private hsg-jinks-data repo
/frus-data-jinks-*.xar
# per-worktree devcontainer settings (ports, compose project name)
.devcontainer/.env

# Cursor: track plans with the branch; ignore local MCP/rules copies
.cursor/rules/

# Codacy CLI: keep .codacy/.gitignore; ignore generated + local config dumps
.codacy/generated/
.codacy/codacy.config.json
.codacy/codacy.config.baseline.json
