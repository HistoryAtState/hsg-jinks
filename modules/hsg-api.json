{
    "components": {
        "securitySchemes": {
            "basicAuth": {
                "scheme": "basic",
                "type": "http"
            },
            "cookieAuth": {
                "in": "cookie",
                "name": "teipublisher.com.login",
                "type": "apiKey"
            }
        }
    },
    "info": {
        "title": "HSG Jinks API",
        "version": "1.0.0"
    },
    "openapi": "3.0.3",
    "paths": {
        "/historicaldocuments/{publicationId}": {
            "get": {
                "summary": "Retrieve landing page for a volume",
                "operationId": "hsgapi:view",
                "x-error-handler": "hsgapi:handle-error",
                "tags": [
                    "hsg"
                ],
                "parameters": [
                    {
                        "name": "template",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": "pages/volume-landing.html"
                        }
                    },
                    {
                        "name": "publicationId",
                        "in": "path",
                        "description": "Relative path to the document",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "allowReserved": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "HTML of the page",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "The document was not found",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/historicaldocuments/{publicationId}/{divisionId}": {
            "get": {
                "summary": "Retrieve interior page for a division",
                "operationId": "hsgapi:view-interior",
                "x-error-handler": "hsgapi:handle-error",
                "tags": [
                    "hsg"
                ],
                "parameters": [
                    {
                        "name": "template",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": "pages/volume-interior.html"
                        }
                    },
                    {
                        "name": "publicationId",
                        "in": "path",
                        "description": "Relative path to the document",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "allowReserved": true
                    },
                    {
                        "name": "divisionId",
                        "in": "path",
                        "description": "ID of the division",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "allowReserved": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "HTML of the page",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "The document was not found",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "servers": [
        {
            "description": "Endpoint for testing on localhost",
            "url": "/exist/apps/jinks"
        }
    ],
    "security": [
        {
            "cookieAuth": []
        },
        {
            "basicAuth": []
        }
    ]
}
