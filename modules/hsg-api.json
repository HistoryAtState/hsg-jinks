{
    "components": {
        "securitySchemes": {
            "basicAuth": {
                "scheme": "basic",
                "type": "http"
            },
            "cookieAuth": {
                "in": "cookie",
                "name": "teipublisher.com.login",
                "type": "apiKey"
            }
        }
    },
    "info": {
        "title": "HSG Jinks API",
        "version": "1.0.0"
    },
    "openapi": "3.0.3",
    "paths": {
        "/historicaldocuments": {
            "get": {
                "summary": "Retrieve the landing page for the Historical Documents section",
                "operationId": "hsgapi:view-section",
                "x-error-handler": "hsgapi:handle-error",
                "tags": [
                    "hsg"
                ],
                "responses": {
                    "200": {
                        "description": "HTML of the page",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/historicaldocuments/about-frus": {
            "get": {
                "summary": "About the Foreign Relations Series: static article on the series and its statutory basis",
                "operationId": "hsgapi:about-frus",
                "x-error-handler": "hsgapi:handle-error",
                "tags": [
                    "hsg"
                ],
                "responses": {
                    "200": {
                        "description": "HTML of the page",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/historicaldocuments/status-of-the-series": {
            "get": {
                "summary": "Status of the Foreign Relations Series: report computed from the volumes' revision metadata",
                "operationId": "hsgapi:status-of-the-series",
                "x-error-handler": "hsgapi:handle-error",
                "tags": [
                    "hsg"
                ],
                "responses": {
                    "200": {
                        "description": "HTML of the page",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/historicaldocuments/frus-history": {
            "get": {
                "summary": "Stub landing page: History of the Foreign Relations Series",
                "operationId": "hsgapi:frus-history",
                "x-error-handler": "hsgapi:handle-error",
                "tags": [
                    "hsg"
                ],
                "responses": {
                    "200": {
                        "description": "HTML of the page",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/historicaldocuments/ebooks": {
            "get": {
                "summary": "Stub landing page: Ebooks Initiative",
                "operationId": "hsgapi:ebooks",
                "x-error-handler": "hsgapi:handle-error",
                "tags": [
                    "hsg"
                ],
                "responses": {
                    "200": {
                        "description": "HTML of the page",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/historicaldocuments/quarterly-releases": {
            "get": {
                "summary": "Quarterly Releases: index of the 2016-2018 digitization releases",
                "operationId": "hsgapi:quarterly-releases",
                "x-error-handler": "hsgapi:handle-error",
                "tags": [
                    "hsg"
                ],
                "responses": {
                    "200": {
                        "description": "HTML of the page",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/historicaldocuments/quarterly-releases/{releaseId}": {
            "get": {
                "summary": "Quarterly Releases: one release announcement page",
                "operationId": "hsgapi:quarterly-release",
                "x-error-handler": "hsgapi:handle-error",
                "tags": [
                    "hsg"
                ],
                "parameters": [
                    {
                        "name": "releaseId",
                        "in": "path",
                        "description": "ID of the release announcement, e.g. 2016-q3",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "allowReserved": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "HTML of the page",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "The release announcement was not found",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/historicaldocuments/{publicationId}": {
            "get": {
                "summary": "Retrieve landing page for a volume",
                "operationId": "hsgapi:view",
                "x-error-handler": "hsgapi:handle-error",
                "tags": [
                    "hsg"
                ],
                "parameters": [
                    {
                        "name": "template",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": "pages/volume/landing.html"
                        }
                    },
                    {
                        "name": "publicationId",
                        "in": "path",
                        "description": "Relative path to the document",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "allowReserved": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "HTML of the page",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "The document was not found",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/historicaldocuments/{publicationId}/{divisionId}": {
            "get": {
                "summary": "Retrieve interior page for a division",
                "operationId": "hsgapi:view-interior",
                "x-error-handler": "hsgapi:handle-error",
                "tags": [
                    "hsg"
                ],
                "parameters": [
                    {
                        "name": "template",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": "pages/volume/interior.html"
                        }
                    },
                    {
                        "name": "publicationId",
                        "in": "path",
                        "description": "Relative path to the document",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "allowReserved": true
                    },
                    {
                        "name": "divisionId",
                        "in": "path",
                        "description": "ID of the division",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "allowReserved": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "HTML of the page",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "The document was not found",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "servers": [
        {
            "description": "Endpoint for testing on localhost",
            "url": "/exist/apps/jinks"
        }
    ],
    "security": [
        {
            "cookieAuth": []
        },
        {
            "basicAuth": []
        }
    ]
}
