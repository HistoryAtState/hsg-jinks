# Baseline: joewiz/hsg-project:v2, the go-live image of this app. It is a
# vector-capable eXist 7 with the whole database baked in (/exist/data):
# hsg-jinks, frus-data-jinks with its vector index, the HistoryAtState data
# packages and the runtime libraries (tei-publisher-lib, jinks-templates,
# roaster, jwt, crypto, carousel). Worktree containers test new versions of
# hsg-jinks against it: init.sh replaces the baked-in app with the worktree's
# build. The tag is tracked, not pinned: `docker compose build --pull` picks up
# a newer v2.
FROM joewiz/hsg-project:v2

ARG HTTP_PORT=8080
ARG HTTPS_PORT=8443

ARG INSTALL_NER="false"
ARG INSTALL_TEXLIVE="false"

#custom-----> Start custom code

# The image carries a JDK but no build tooling; init.sh builds the app with
# ant inside the container, and the jinks build below needs git.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ant git curl ca-certificates gnupg

RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y nodejs \
    && node -v && npm -v

# Install python pip and upgrade it to latest version
RUN if [ "${INSTALL_NER}" = "true" ]; then \
    apt-get -y install --no-install-recommends python3-pip \
    && pip3 install --break-system-packages --upgrade pip; \
    fi

# Install the TeXLive distribution for LaTeX support
RUN if [ "${INSTALL_TEXLIVE}" = "true" ]; then \
    apt-get -y install --no-install-recommends \
    texlive-xetex \
    texlive-latex-extra \
    texlive-fonts-recommended \
    texlive-lang-german \
    texlive-lang-european \
    texlive-humanities \
    texlive-plain-generic \
    fonts-junicode \
    latexmk; \
    fi

WORKDIR /workspaces

RUN if [ "${INSTALL_NER}" = "true" ]; then \
    # Install tei-publisher-ner plus German and English language models
    git clone https://github.com/eeditiones/tei-publisher-ner.git \
    && cd tei-publisher-ner \
    && pip3 install --break-system-packages --no-cache-dir --upgrade -r requirements.txt \
    && pip3 install --break-system-packages --no-cache-dir gunicorn \
    && python3 -m spacy download de_core_news_sm \
    && python3 -m spacy download en_core_web_sm; \
    fi

# eXist lives at /exist in this image; the rest of this repo's tooling
# expects /usr/local/exist.
RUN ln -s /exist /usr/local/exist

# Development additions the go-live image does not carry. eXist autodeploys
# whatever in autodeploy/ is not installed yet, in alphabetical order, so these
# install on first boot, after the image's own packages.
#
# The jinks generator is built from main: we track jinks main. The zz- prefix
# installs it after its dependencies (jinks-templates, tei-publisher-lib,
# roaster, jwt).
RUN git clone https://github.com/eeditiones/jinks.git \
    && cd jinks \
    && ant \
    && cp build/*.xar /usr/local/exist/autodeploy/zz-jinks.xar

# profile-theme-uswds is a PRIVATE repo, so it cannot be fetched anonymously
# here. Instead we copy in a xar built from the local checkout; new-worktree.sh
# copies it from ~/.config/hsg/xars/. The xar is gitignored: it is a build
# artifact, not source.
COPY profile-theme-uswds-*.xar /usr/local/exist/autodeploy/zzz-profile-theme-uswds.xar


WORKDIR /usr/local/exist

EXPOSE ${HTTP_PORT} ${HTTPS_PORT} 8001 5005

# The image's own JAVA_TOOL_OPTIONS plus -Xss16m. JAVA_TOOL_OPTIONS applies to
# every java process in the container, so keep it free of a JDWP agent: once
# eXist holds the debug port, any other java process (ant in init.sh) fails to
# start.
#
# -Xss16m: jinks' generator:filter-conflicts (modules/generator.xql:133) is
# non-tail-recursive with one frame per file written. profile-theme-uswds copies
# ~2600 resource files, which overflows the default JVM thread stack and makes
# POST /api/generator fail with java.lang.StackOverflowError. Remove once jinks
# makes that function iterative.
ENV JAVA_TOOL_OPTIONS="-Dfile.encoding=UTF8 -Dsun.jnu.encoding=UTF-8 -Djava.awt.headless=true -Dorg.exist.db-connection.cacheSize=256M -Dorg.exist.db-connection.pool.max=20 -Dlog4j.configurationFile=/exist/etc/log4j2.xml -Dexist.home=/exist -Dexist.configurationFile=/exist/etc/conf.xml -Djetty.home=/exist -Dexist.jetty.config=/exist/etc/jetty/standard.enabled-jetty-configs -XX:+UseNUMA -XX:+UseZGC -XX:+UseStringDeduplication -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError -Xss16m"
