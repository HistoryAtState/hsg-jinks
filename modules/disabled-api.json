{
    "openapi": "3.0.3",
    "info": {
        "title": "Disabled generator routes",
        "description": "Routes of the generated API (modules/lib/api.json) that this app does not serve: document editing, conversion and preview, app download, NLP, register editing and form templates. In the production build also the ODD, lint, fix-odds and LaTeX routes. Listed ahead of lib/api.json, each answers 404 like an unknown path. A path declared here replaces lib/api.json's whole path item, so the other methods of these paths are repeated unchanged.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "description": "Endpoint for testing on localhost",
            "url": "/exist/apps/hsg-jinks"
        }
    ],
    "components": {
        "securitySchemes": {
            "basicAuth": {
                "type": "http",
                "scheme": "basic"
            },
            "cookieAuth": {
                "type": "apiKey",
                "name": "teipublisher.com.login",
                "in": "cookie"
            }
        }
    },
    "security": [
        {
            "cookieAuth": []
        },
        {
            "basicAuth": []
        }
    ],
    "paths": {
        "/api/parts/{doc}/{format}": {
            "get": {
                "summary": "Not served by this app",
                "operationId": "disabledapi:not-found",
                "parameters": [
                    {
                        "name": "doc",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "example": "doc/documentation.xml",
                        "description": "path to the document, relative to TEI Publisher's data root colletion"
                    },
                    {
                        "name": "format",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "json",
                                "html"
                            ]
                        },
                        "description": "the format to return: either `json` or `html`. The first returns the HTML inside a JSON record with additional information about the next/previous page and so on. The latter is mainly for debugging purposes."
                    }
                ],
                "x-error-handler": "hsg-errors:handle",
                "responses": {
                    "404": {
                        "description": "Not found",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/document/{id}": {
            "get": {
                "summary": "Get the source of a document",
                "description": "Get the source of a document, either as XML, text or binary.",
                "tags": [
                    "documents"
                ],
                "operationId": "dapi:source",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "type",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Content of the document",
                        "content": {
                            "application/xml": {
                                "schema": {
                                    "type": "string"
                                }
                            },
                            "text/markdown": {
                                "schema": {
                                    "type": "string"
                                }
                            },
                            "text/text": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "410": {
                        "description": "Document deleted"
                    }
                }
            },
            "delete": {
                "summary": "Delete a document",
                "tags": [
                    "documents"
                ],
                "operationId": "dapi:delete",
                "x-constraints": {
                    "groups": [
                        "tei"
                    ]
                },
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "410": {
                        "description": "Document deleted"
                    }
                }
            },
            "put": {
                "summary": "Not served by this app",
                "operationId": "disabledapi:not-found",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "path to the document",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "x-error-handler": "hsg-errors:handle",
                "responses": {
                    "404": {
                        "description": "Not found",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
