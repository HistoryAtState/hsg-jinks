            <sourceDesc>
                <p>Generated by <ref target="http://tei-publisher.org">TEI Publisher</ref>
                </p>
                <p>born digital</p>
            </sourceDesc>
        </fileDesc><encodingDesc><tagsDecl/></encodingDesc><revisionDesc>
            <change when="2025-11-10T19:08:27.185+01:00">Initial version</change>
        </revisionDesc></teiHeader><text>
        <body>
            <schemaSpec start="TEI teiCorpus" source="frus.odd">
                <!-- ============================================================
                     Guards against the vendored FRUS ODD (resources/odd/frus.odd).
                     TEI Publisher's odd:merge REPLACES a parent elementSpec
                     wholesale when this file redeclares it with models, so each
                     spec below reinstates the teipublisher.odd behaviour that
                     upstream's print-derived model would otherwise displace.
                     Upstream is not wrong; it is internally consistent with its
                     OWN design. This app adopted upstream's list/dateline design
                     (OP#1317): the former item, label and opener guards are gone,
                     list styling lives in resources/css/hsg-theme.css, and the
                     dateline spec below keeps upstream's opener-as-paragraph
                     valid. Remove a remaining guard only together with the
                     app-side change that makes upstream's version work here.
                     ============================================================ -->
                <!-- Upstream's only divGen model is output="print", which would
                     leave the web pipeline with no model at all. The volume
                     root's divGen xml:id="toc" placeholder is load-bearing here
                     (modules/hsg-api.xql, and it has regressed once before;
                     see volume-front-back-matter.cy.js). -->
                <elementSpec ident="divGen" mode="change">
                    <model behaviour="block"/>
                </elementSpec>
                <!-- Upstream omits titlePage outright, which is right for its
                     print pipeline and wrong for volume front matter on the web. -->
                <elementSpec ident="titlePage" mode="change">
                    <model behaviour="block" useSourceRendition="true"/>
                </elementSpec>
                <!-- Upstream drops the browse/toc inline model and the
                     figure/table/lg/list cssClass hooks. This app sets
                     display="browse" (modules/lib/api/collection.xql,
                     modules/templates/browse.xqm) and styles .table-head
                     (resources/css/epub.css), so both are still needed.
                     This restores teipublisher.odd's list verbatim and adopts
                     none of upstream's head refinements: its table head is a
                     pass-through emitting a caption, which would need its own
                     verification against this app's table styling. Revisit
                     together, not piecemeal. -->
                <elementSpec ident="head" mode="change">
                    <model predicate="$parameters?display='browse' or $parameters?mode='toc'" behaviour="inline"/>
                    <model predicate="parent::figure" behaviour="block" cssClass="figure-head"/>
                    <model predicate="parent::table" behaviour="block" cssClass="table-head"/>
                    <model predicate="parent::lg" behaviour="block" cssClass="lg-head"/>
                    <model predicate="parent::list" behaviour="block" cssClass="list-head"/>
                    <model predicate="parent::div" behaviour="heading"/>
                    <model behaviour="block"/>
                </elementSpec> <elementSpec ident="div" mode="change"><model predicate="$parameters?mode=('volume-landing', 'volume-interior')" behaviour="block"/><model predicate="$parameters?mode = 'register'" behaviour="pass-through">
            <desc>Output register data if register profile is enabled</desc>
            <param name="people" value="let $refs := (root(.)//persName[@key or @ref], root(.)//rs[@type='person'][@key or @ref]) let $keys := for $i in ($refs/@key, $refs/@ref) return $i ! tokenize(., ' ')  for $key in distinct-values($keys) return collection($global:register-root)/id($key)[self::person]"/>
            <param name="places" value="let $refs := (root(.)//placeName[@key or @ref], root(.)//rs[@type='place'][@key or @ref]) let $keys := for $i in ($refs/@key, $refs/@ref) return $i ! tokenize(., ' ')  for $key in distinct-values($keys) return collection($global:register-root)/id($key)[self::place]"/>
            <pb:template xml:space="preserve"><div xmlns="" class="register">
<h3><pb-i18n key="register-details.people">ppl</pb-i18n></h3>
<ul>
[[people]]
</ul>

<h3><pb-i18n key="register-details.places">pl</pb-i18n></h3>
<ul>
[[places]]
</ul>
</div></pb:template>
        </model><model predicate="parent::body or parent::front or parent::back" behaviour="section"/><model behaviour="block"/></elementSpec>
                <elementSpec ident="xi:include" mode="change"><model predicate="$parameters?mode='volume-landing'" behaviour="listItem" pb:mode="interior">
            <desc>Process xincludes on a landing page</desc>
            <param name="content" value="id(@xpointer, doc(util:collection-name(.) || '/' || @href))/ancestor::TEI//titleStmt/title"/>
        </model><model predicate="$parameters?mode='volume-interior'" behaviour="listItem" pb:mode="document">
            <desc>Process xincludes on an interior page</desc>
            <param name="content" value="id(@xpointer, doc(util:collection-name(.) || '/' || @href))/ancestor::TEI//titleStmt/title"/>
        </model><model predicate="$parameters?mode='document-view'" behaviour="pass-through">
            <desc>Inline an xincluded attachment into its parent document. Documents include their attachments into text/back, and pass-through emits no wrapper, so handing the attachment's TEI root back to the document-view models lets the attachment-label model above render it in place.</desc>
            <param name="content" value="id(@xpointer, doc(util:collection-name(.) || '/' || @href))/ancestor-or-self::TEI"/>
        </model></elementSpec>
            <elementSpec ident="TEI" mode="change"><model predicate="$parameters?mode=('volume-landing', 'volume-interior')" behaviour="block">
            <param name="content" value="./text/body//xi:include"/>
            <param name="head" value="let $fileDesc := .//teiHeader/fileDesc let $inline := $fileDesc/*[local-name()='titleStmt'] let $titleStmt := if (exists($inline)) then $inline else let $inc := $fileDesc/xi:include[@xpointer='titleStmt'] return id('titleStmt', doc(util:collection-name($inc) || '/' || $inc/@href)) return $titleStmt/title"/>
            <pb:template xml:space="preserve"><div xmlns="">
  [[head]]
  <ul>
    [[content]]
  </ul>
</div></pb:template>
        </model><model predicate="$parameters?mode='metadata-panel'" behaviour="pass-through">
            <param name="content" value="teiHeader"/>
        </model><model predicate="$parameters?mode='edition-navigation' and descendant::correspContext" behaviour="pass-through">
            <desc>process correspContext to provide in-edition navigation buttons to move between documents</desc>
            <param name="content" value="descendant::correspContext"/>
        </model><model predicate="$parameters?mode = 'register'" behaviour="pass-through">
            <desc>Output register data if register profile is enabled</desc>
            <param name="people" value="for $key in distinct-values((root(.)//persName/@key, root(.)//persName/@ref)) return collection($global:register-root)/id($key)[self::person]"/>
            <param name="places" value="for $key in distinct-values((root(.)//placeName/@key, root(.)//placeName/@ref)) return collection($global:register-root)/id($key)[self::place]"/>
            <pb:template xml:space="preserve"><div xmlns="" class="register">
<h3>People</h3>
<ul>
[[people]]
</ul>

<h3>Places</h3>
<ul>
[[places]]
</ul>
</div></pb:template>
        </model><model predicate="$parameters?mode='document-view' and normalize-space(.//bibl[@type='frus-attachment-label']) != ''" behaviour="block">
            <desc>An attachment ("Tab I") inlined into its parent document, as the reference site renders it. Only the label is synthesized: the reference site reads it from an inline note at the top of the attachment's own body, and the v2 data moved that into the teiHeader as bibl[@type='frus-attachment-label']. Everything else comes out of the attachment's body, which already holds its title (with the source note's anchor inside it) and its opener with the dateline; rendering the body only is the same treatment the document models below get, and for the same reason: synthesizing head and dateline from the teiHeader as well showed each attachment's title and place/date twice, and put two elements carrying the same footnote-marker id on the page. The attachment has no footnote list of its own -- its notes merge into the parent's consolidated list, which is why their @n continue the parent's sequence -- and no document number either, its frus-document-number bibl being present but empty.</desc>
            <param name="label" value=".//bibl[@type='frus-attachment-label']"/>
            <param name="content" value="text/body"/>
            <pb:template xml:space="preserve"><div xmlns="" class="attachment">
  <hr class="attachment-divider"/>
  <p class="attachment-label">[[label]]</p>
  [[content]]
</div></pb:template>
        </model><model predicate="$parameters?mode='document-view' and exists(.//standOff//note)" behaviour="block">
            <desc>A document with footnotes (333 of 341). Reference parity with hsg-shell: render the body div only -- its own head (which already carries the number, e.g. "72. Telegram...", and the source-note marker as an in-body anchor) and its opener (print page number and dateline). The teiHeader title/dateline are metadata for page chrome (breadcrumb, title), not rendered inline, so head, place and date each appear once. No volume title either: it is the same string in titleStmt and in seriesStmt/title[@type='complete'] for all 694 volumes, and hsg:navigation-title already puts it above the content of every interior page, so rendering it here as an overline showed it twice (the reference site shows it once, and has no overline at all). Footnotes are consolidated from this document and any inlined attachments, ordered by @n.</desc>
            <param name="content" value="text/body"/>
            <param name="attachments" value="text/back/xi:include"/>
            <param name="footnotes" value="let $att := (text/body//xi:include ! (id(@xpointer, doc(util:collection-name(.) || '/' || @href))/root()//standOff//note)) return (for $note in (.//standOff//note, $att) order by number($note/@n) return $note)"/>
            <pb:template xml:space="preserve"><div xmlns="">
  [[content]]
  [[attachments]]
  <hr class="footnotes-divider"/>
  <ol class="footnotes">[[footnotes]]</ol>
</div></pb:template>
        </model><model predicate="$parameters?mode='document-view'" behaviour="block">
            <desc>A document without footnotes (8 of 341: 7 editorial notes and 1 historical document). Same body-only rendering as above; no source note exists, so no ruler or footnote list is emitted.</desc>
            <param name="content" value="text/body"/>
            <pb:template xml:space="preserve"><div xmlns="">
  [[content]]
</div></pb:template>
        </model><model predicate="$parameters?mode='division'" behaviour="pass-through">
            <desc>Render a division document's text content without the HTML document skeleton, so it can be embedded in a page's main element</desc>
            <param name="content" value="text/body"/>
        </model><model behaviour="document"/></elementSpec>
            <elementSpec ident="title" mode="change"><model predicate="$mode='interior'" behaviour="link">
            <desc>Coming from a landing page, list interior pages</desc>
            <param name="uri" value="root(.)//bibl[@type='frus-volume-id'] || '/' || root(.)//bibl[@type='frus-division-id']"/>
        </model><model predicate="$mode='document'" behaviour="link">
            <desc>Coming from an interior page, list documents</desc>
            <param name="uri" value="root(.)//bibl[@type='frus-division-id']"/>
        </model><model predicate="$parameters?mode=('volume-landing', 'volume-interior')" behaviour="heading"/><model predicate="$parameters?mode='metadata-panel'" behaviour="block"/><model predicate="$parameters?mode='register-details' and $parameters?static" behaviour="link">
            <param name="uri" value="$parameters?context-path || &#34;/letters/&#34; || util:document-name(.) || '/1/index.html'"/>
            <param name="content" value="string()"/>
        </model><model predicate="$parameters?mode='register-details'" behaviour="link">
            <desc>create a link to the document, respecting address-by-id configuration</desc>
            <param name="content" value="string()"/>
            <param name="uri" value="if ($global:address-by-id) then                             '../' || root(.)/descendant-or-self::TEI/@xml:id                                                      else                                 '../' || substring-after(document-uri(root(.)), $global:data-root || '/')"/>
        </model><model predicate="$parameters?display='browse'" behaviour="heading">
            <param name="level" value="5"/>
        </model><model predicate="@key or @ref" behaviour="alternate">
            <param name="alternate" value="let $key:= head((@key, @ref))  return collection($global:register-root)/id($key)"/>
            <param name="default" value="."/>
        </model><model behaviour="inline"/></elementSpec>
            <elementSpec ident="date" mode="change"><model predicate="$parameters?mode='document-view'" behaviour="inline">
            <desc>In a dateline, render the date as the encoding has it. Without this, the @when model below wins and renders the date twice - once as text and once reformatted ("March 11, 1985" followed by "11th March 1985") - because alternate emits both.</desc>
        </model><model predicate="$parameters?display='browse' or $parameters?mode=('breadcrumb', 'title')" behaviour="inline"/><model predicate="@when" behaviour="alternate">
                        <param name="default" value="if (normalize-space(.)) then . else @when/string()"/>
                        <param name="alternate" value="try { format-date(xs:date(@when), '[D1o] [MNn] [Y]', ($parameters?language, 'en')[1], (), ()) } catch * { @when/string() }"/>
                    </model><model behaviour="inline"/></elementSpec>
            <elementSpec ident="setting" mode="add"><model predicate="$parameters?mode='document-view' and placeName[normalize-space(.) != ''] and date[normalize-space(.) != '']" behaviour="block">
            <desc>Dateline, place and date (327 of 341 documents). The comma is supplied here: the encoding has no separator between placeName and date.</desc>
            <param name="place" value="placeName"/>
            <param name="date" value="date[normalize-space(.) != ''][1]"/>
            <pb:template xml:space="preserve"><p xmlns="" class="dateline">[[place]], [[date]]</p></pb:template>
        </model><model predicate="$parameters?mode='document-view' and date[normalize-space(.) != '']" behaviour="block">
            <desc>Dateline, date only (4 documents, e.g. d299, d125-a1) - no comma, since there is no place to separate it from.</desc>
            <param name="date" value="date[normalize-space(.) != ''][1]"/>
            <pb:template xml:space="preserve"><p xmlns="" class="dateline">[[date]]</p></pb:template>
        </model><model predicate="$parameters?mode='document-view'" behaviour="omit">
            <desc>No dateline (10 documents, e.g. d304 and the appendices). The setting element is always present but is empty for these, so render nothing rather than an empty line.</desc>
        </model></elementSpec>
            <elementSpec ident="anchor" mode="change"><model predicate="$parameters?mode='document-view' and @xml:id" behaviour="pass-through">
            <desc>FRUS footnote marker. The note points at the anchor (note/@corresp = '#' || anchor/@xml:id), the reverse of the base models below, which expect the anchor to point at the note - so those never match FRUS data and the marker fell through to the bare anchor model, rendering an empty span. Every in-body anchor in the corpus resolves to a note, so no fallback is needed.
                The rendered id is qualified with the division the page is showing (global:division-id, i.e. {page division}-f{note @n}), NOT the anchor's raw @xml:id: each attachment file restarts its anchor ids at {parent}-f1 (d96-a1.xml and d96-a2.xml both carry d96-f1..f3), so a consolidated page built from @xml:id verbatim repeated the same DOM id three times and every marker resolved to the parent's note. @n continues the parent's sequence across the attachments, so one prefix for the whole page plus @n is unique. For a stand-alone document ({div}.xml with anchors {div}-f{seq} and @n = seq, the corpus norm) this yields exactly the same ids as before.
                Expression-shape caveat, learned the hard way: wrapping the note lookup as a parenthesized-then-[1] step ("(root(.)//...)[1]/@n") comes back empty when compiled into a model param, while the plain path with a trailing /@n/string() works; keep these params in the plain shape (@corresp is unique within a file, so no [1] is needed).</desc>
            <param name="noteId" value="let $target := '#' || @xml:id return global:division-id($parameters, .) || '-f' || root(.)//standOff//note[@corresp = $target]/@n/string()"/>
            <param name="refId" value="let $target := '#' || @xml:id return global:division-id($parameters, .) || '-f' || root(.)//standOff//note[@corresp = $target]/@n/string() || 'ref'"/>
            <param name="label" value="let $target := '#' || @xml:id return root(.)//standOff//note[@corresp = $target]/@n/string()"/>
            <pb:template xml:space="preserve"><sup xmlns="" class="footnote-ref"><a id="[[refId]]" href="#[[noteId]]">[[label]]</a></sup></pb:template>
        </model><model predicate="$parameters?mode=('toc', 'breadcrumb')" behaviour="omit"/><model predicate="@corresp" behaviour="note">
            <desc>Process notes with corresp attribute (assuming the note is stand off,
                            somewhere in the same document)</desc>
            <param name="content" value="let $target := @corresp return root($parameters?root)/id($target)/node()"/>
            <param name="label" value="@n"/>
        </model><model predicate="@type='note'" behaviour="note">
            <desc>Process notes with @type=note (assuming the note is stand off,
                            in the listAnnotation section in the same document)</desc>
            <param name="content" value="let $target := '#' || @xml:id return root($parameters?root)//listAnnotation/note[@target=$target]/node()"/>
            <param name="label" value="let $target := '#' || @xml:id return root($parameters?root)//listAnnotation/note[@target=$target]/@n/string()"/>
        </model><model predicate="@xml:id" behaviour="anchor">
            <param name="id" value="@xml:id"/>
        </model></elementSpec>
            <elementSpec ident="note" mode="change"><model predicate="$parameters?mode='document-view' and ancestor::listAnnotation" behaviour="pass-through">
            <desc>FRUS footnote, rendered as an item of the document's consolidated list. @value carries the encoded number rather than relying on the ol's own counter, because an inlined attachment's notes continue the parent's sequence and so do not start at 1. The source note has no in-body anchor, so its backlink targets the marker on the heading. The id is qualified with the page's division ({page division}-f{@n}) for the same reason as the anchor marker above; @corresp taken verbatim collided across a parent and its attachments.</desc>
            <param name="n" value="@n/string()"/>
            <param name="noteId" value="global:division-id($parameters, .) || '-f' || @n"/>
            <param name="refId" value="global:division-id($parameters, .) || '-f' || @n || 'ref'"/>
            <param name="content" value="node()"/>
            <pb:template xml:space="preserve"><li xmlns="" id="[[noteId]]" value="[[n]]">[[content]] <a class="footnote-backlink" href="#[[refId]]" aria-label="Back to content">↩</a></li></pb:template>
        </model><model predicate="$parameters?mode='register-overview' and $parameters?show-notes and text()" behaviour="block">
            <desc>When show-notes parameter is set, display note in register overview (index)</desc>
        </model><model predicate="$parameters?mode='register-overview' and not($parameters?show-notes)" behaviour="omit">
            <desc>Omit notes in register overview (index) When show-notes parameter is not set</desc>
        </model><model predicate="parent::person or parent::place or parent::org" behaviour="paragraph"/><model predicate="$parameters?mode='toc' or ancestor::listAnnotation" behaviour="omit"/><model predicate="$parameters?mode='monograph-section' and not(@place)" behaviour="note">
            <desc>Buildings' 357 footnotes (#1096, PR follow-up) carry no @place attribute at
                all -- the base ODD's own fallback below reads @place verbatim, so with it
                absent every note fell back to the "note" behaviour's own default placement,
                rendered inline instead of collected at the foot of the page (compare
                /departmenthistory/buildings/section1 live against the reference site, which
                does show them as footnotes). Short History has no tei:note elements at all
                (0, confirmed), so this is Buildings-only in practice, but scoped by mode
                rather than collection to match wherever dh:monograph-section-content's own
                page:transform call applies. Mirrors the reference implementation's own fix
                for the same app (../hsg-project/repos/hsg-shell/resources/odd/source/
                departmenthistory.odd), which hardcodes place="foot" the same way rather than
                relying on source data that was never encoded with it.</desc>
            <param name="place" value="'foot'"/>
            <param name="label" value="@n"/>
        </model><model predicate="@rend='inline'" behaviour="paragraph">
            <desc>An inline prose note that is not a footnote (e.g. the prefatory "[This list of persons ...]" note on the persons and terms front-matter pages). Render as a plain paragraph with no footnote marker or number, reference parity with hsg-shell's frus.odd note[@rend='inline']. Without this it fell through to the note behaviour below and was numbered "1" as a footnote.</desc>
        </model><model behaviour="note">
            <param name="place" value="@place"/>
            <param name="label" value="@n"/>
        </model></elementSpec>
            <elementSpec ident="teiHeader" mode="change"><model output="latex" behaviour="metadata"/><model output="fo" behaviour="omit"/><model predicate="$parameters?mode='metadata-panel'" behaviour="pass-through"/><model predicate="$parameters?display='browse'" behaviour="block"/><model behaviour="metadata"/></elementSpec>
            <elementSpec ident="placeName" mode="change">
                <desc>The base teipublisher.odd's last-resort model for a placeName carrying
                    @key/@ref (behaviour="alternate") unconditionally looks the key up in
                    collection($global:register-root)/id('pb-places') -- this app has no
                    register/authority-file collection at all (registers/ 404s), so that id()
                    call receives zero nodes where its own signature requires exactly one,
                    crashing with XPTY0004 on every placeName that carries @key/@ref (found via
                    rdcr articles, #1095/#1128 -- e.g. placeName[@key='kanagawa'] in
                    countries/japan). Render inline instead whenever no register mode is in
                    play, matching what the base ODD already does for a plain placeName with
                    no @key.</desc>
                <model predicate="(@key or @ref) and not($parameters?mode = ('register', 'register-details', 'register-overview'))" behaviour="inline"/>
            </elementSpec>
            <elementSpec ident="persName" mode="change">
                <desc>Same register-lookup crash as placeName above (id(@key,
                    collection($global:register-root)/id('pb-persons')) against a
                    non-existent register), same fix.</desc>
                <model predicate="(@key or @ref) and not($parameters?mode = ('register', 'register-details', 'register-overview'))" behaviour="inline"/>
            </elementSpec>
            <elementSpec ident="graphic" mode="change">
                <desc>Several data collections carry tei:graphic/@url as a bare filename (e.g.
                    "japan-flag.jpg" for rdcr countries #1095/#1128; "sh-bfranklin.jpg" for
                    short-history, "1-homes-cover.jpg" for buildings, "jefferson-thomas.jpg" for
                    secretary-bios, #1096 PR review; "wilson-woodrow.jpg" for milestones, #1098)
                    with no base-URI logic anywhere in the base
                    ODD, so they would render as broken relative srcs. The reference site
                    resolves each against its own static.history.state.gov/{collection}/ prefix
                    (confirmed live per collection); reproduced here as per-collection models,
                    matched by the source document's collection path via global:source-uri, tried in
                    order with the original countries model kept last as the fallback for any
                    other bare-filename graphic. Some short-history graphics carry a "../"-
                    relative filename (e.g. "../secretaries/hull-cordell.jpg", for secretaries
                    who are also pictured inline in the short-history text) -- string-concatenating
                    onto the short-history prefix produces "short-history/../secretaries/...",
                    which browsers (and static.history.state.gov itself) resolve like any other
                    relative URL, so no special-casing was needed for those. Each model is scoped
                    to only the "bare filename" shape (no scheme, no leading slash) so it doesn't
                    touch any graphic that already carries a full path/URL elsewhere in the
                    app.</desc>
                <model predicate="not(matches(@url, '^(?:[a-z]+://|/)')) and global:volume-id($parameters, .) != ''" behaviour="graphic">
                    <desc>FRUS document graphics (PR #32 review audit): the v2 corpus encodes
                        graphic/@url as a bare, extension-less basename (e.g. "d312p1" in
                        frus1981-88v05 appC). Reference parity with hsg-shell's frus.odd graphic
                        model: resolve against static.history.state.gov/frus/{volume-id}/ and
                        append ".png" unless the name already carries an image extension. Without
                        this model such graphics fell through to the countries fallback below and
                        rendered a broken countries/ URL. global:volume-id reads the volume from
                        the collection path of the document being rendered, and is empty outside
                        the FRUS collection, which is what makes it the predicate here too.</desc>
                    <param name="url" value="'https://static.history.state.gov/frus/' || global:volume-id($parameters, .) || '/' || @url || (if (matches(@url, '\.(jpg|jpeg|png|gif|svg)$')) then '' else '.png')"/>
                    <param name="width" value="@width"/>
                    <param name="height" value="@height"/>
                    <param name="scale" value="@scale"/>
                    <param name="title" value="(../desc, ../figDesc) => head() => normalize-space()"/>
                </model>
                <model predicate="not(matches(@url, '^(?:[a-z]+://|/)')) and contains(global:source-uri($parameters, .), '/other-publications/short-history/')" behaviour="graphic">
                    <param name="url" value="'https://static.history.state.gov/short-history/' || @url"/>
                    <param name="width" value="@width"/>
                    <param name="height" value="@height"/>
                    <param name="scale" value="@scale"/>
                    <param name="title" value="desc"/>
                </model>
                <model predicate="not(matches(@url, '^(?:[a-z]+://|/)')) and contains(global:source-uri($parameters, .), '/other-publications/buildings/')" behaviour="graphic">
                    <param name="url" value="'https://static.history.state.gov/buildings/' || @url"/>
                    <param name="width" value="@width"/>
                    <param name="height" value="@height"/>
                    <param name="scale" value="@scale"/>
                    <param name="title" value="desc"/>
                </model>
                <model predicate="not(matches(@url, '^(?:[a-z]+://|/)')) and contains(global:source-uri($parameters, .), '/other-publications/secretary-bios/')" behaviour="graphic">
                    <param name="url" value="'https://static.history.state.gov/secretaries/' || @url"/>
                    <param name="width" value="@width"/>
                    <param name="height" value="@height"/>
                    <param name="scale" value="@scale"/>
                    <param name="title" value="desc"/>
                </model>
                <model predicate="not(matches(@url, '^(?:[a-z]+://|/)')) and contains(global:source-uri($parameters, .), '/milestones/chapters/')" behaviour="graphic">
                    <param name="url" value="'https://static.history.state.gov/milestones/' || @url"/>
                    <param name="width" value="@width"/>
                    <param name="height" value="@height"/>
                    <param name="scale" value="@scale"/>
                    <param name="title" value="desc"/>
                </model>
                <model predicate="not(matches(@url, '^(?:[a-z]+://|/)')) and contains(global:source-uri($parameters, .), '/conferences/data/')" behaviour="graphic">
                    <param name="url" value="'https://static.history.state.gov/conferences/' || @url"/>
                    <param name="width" value="@width"/>
                    <param name="height" value="@height"/>
                    <param name="scale" value="@scale"/>
                    <param name="title" value="desc"/>
                </model>
                <model predicate="not(matches(@url, '^(?:[a-z]+://|/)'))" behaviour="graphic">
                    <param name="url" value="'https://static.history.state.gov/countries/' || @url"/>
                    <param name="width" value="@width"/>
                    <param name="height" value="@height"/>
                    <param name="scale" value="@scale"/>
                    <param name="title" value="desc"/>
                </model>
                <model behaviour="graphic">
                    <desc>Conferences (#1099 PR review): this elementSpec's mode="change" leaves no
                        fallback for a @url that already carries a full scheme -- every model above
                        guards on "not an absolute URL". The conferences photo gallery's graphics are
                        already fully-qualified (static.history.state.gov/gallery/... baked into the
                        source data, unlike every other collection's bare filenames), so they matched
                        no model at all and silently rendered nothing. Catch-all, unconditional,
                        ordered last: renders @url as-is for anything the predicated models above
                        didn't already claim.</desc>
                    <param name="url" value="@url"/>
                    <param name="width" value="@width"/>
                    <param name="height" value="@height"/>
                    <param name="scale" value="@scale"/>
                    <param name="title" value="desc"/>
                </model>
            </elementSpec>
            <elementSpec ident="xhtml:div" mode="change">
                <desc>Conferences (#1114): 12 Brightcove video embeds are pasted verbatim into the
                    TEI as raw xhtml-namespaced markup -- an outer div wrapping a padding-ratio div
                    wrapping a video.video-js element plus a sibling script tag that loads
                    players.brightcove.net's embed script and executes inline. Third-party inline
                    scripts pasted into data are a CSP/data-hygiene liability (this app's CSP would
                    have to special-case a third-party host to let them run at all), so this model
                    matches only that specific shape (outer div whose grandchild is a video.video-js
                    carrying data-account/data-player/data-video-id) and replaces the whole subtree
                    -- video, script, and all -- with Brightcove's own iframe embed URL built from
                    those three ids. The original script node is never rendered or executed; nothing
                    in this ODD passes xhtml:script/xhtml:object through generically (unlike
                    hsg-shell's frus.odd, which whitelists them app-wide -- the exact escape hatch
                    this model exists to avoid repeating). Scoped narrowly enough that any other
                    stray xhtml content (e.g. dead/commented-out markup elsewhere in the same
                    documents, which page:transform never sees since XML comments aren't nodes) has
                    no matching model and is simply omitted.</desc>
                <model predicate="xhtml:div/xhtml:video[contains(concat(' ', @class, ' '), ' video-js ')][@data-account][@data-player][@data-video-id]" behaviour="pass-through">
                    <param name="account" value="(.//xhtml:video/@data-account)[1]/string()"/>
                    <param name="player" value="(.//xhtml:video/@data-player)[1]/string()"/>
                    <param name="videoId" value="(.//xhtml:video/@data-video-id)[1]/string()"/>
                    <pb:template xml:space="preserve"><div xmlns="" class="conf-video-embed" style="position: relative; padding-top: 56.25%;"><iframe src="https://players.brightcove.net/[[account]]/[[player]]_default/index.html?videoId=[[videoId]]" allowfullscreen="allowfullscreen" allow="encrypted-media" style="position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; border: 0;"></iframe></div></pb:template>
                </model>
            </elementSpec>
            <elementSpec ident="dateline" mode="change">
                <desc>Upstream's dateline design (OP#1317): a dateline reads as one line, placed by its source rendition ("#float-right" sits it opposite the print page number's "#float-left" seg; "#center" gets display:block back in hsg-theme.css). It must be INLINE: upstream's opener is a paragraph, and a block dateline inside it would be a "div" in a "p" -- invalid HTML the browser repairs by closing the paragraph early (the reason the retired opener guard existed). The float classes come from resources/css/frus-renditions.css.</desc>
                <model behaviour="inline" cssClass="dateline" useSourceRendition="true"/>
            </elementSpec>
            <elementSpec ident="list" mode="change">
                <desc>FRUS document lists, reference parity with hsg-shell's frus.odd list model. The base teipublisher.odd model renders every list with disc bullets and, worse, passes child::node() so a label is emitted twice -- once as raw text and once as the definition-list term (the "SUBJECT SUBJECT" / "1. 1." duplication). Each model below passes only the items, so pmf:list pairs each item with its preceding label into a dt/dd with no duplication:
                    - persons/terms front-matter name lists: no bullets, hanging indent (list-person).
                    - a list opened by a head (e.g. "Ref:"): the head as a bold heading, items as a no-bullet indented list.
                    - a description list (label + item, e.g. "SUBJECT"): a definition list whose term is bold and sits above its indented value.
                    - a label/item list (the numbered paragraphs "1.", "2." and lettered "(A)"..): a definition list whose label sits inline, on the same line as the item text, with no bullets and no auto-numbering.
                    The first model keys on an xml:id, which is only sound if that id means one thing (PR #32 review). Checked over the whole 694-volume corpus, not just the volumes deployed here: "persons" and "terms" occur on 596 elements in total, every one of them a body/div and at most one per file, and they appear in no file other than a register's own persons.xml / terms.xml. The predicate spells out that body/div position so a future nested div reusing the id could not silently pick up the register styling.</desc>
                <modelSequence predicate="tei:head">
                    <model behaviour="heading" cssClass="frus-list-head">
                        <param name="content" value="tei:head/node()"/>
                        <param name="level" value="4"/>
                    </model>
                    <model behaviour="list" cssClass="frus-list">
                        <param name="content" value="tei:item"/>
                    </model>
                </modelSequence>
                <model behaviour="pass-through" predicate="@type = 'description' or (not(@type) and parent::tei:item/parent::tei:list[@type = 'description'])">
                    <desc>Upstream frus.odd's description-list design (OP#1317): the
                        dt/dd-shaped FRUS list renders as a "ul.description" whose label
                        is its own heading line and whose entries hang; nested untyped
                        lists inside an entry are groups and take the same shape. The
                        li / li.listLabel children come from upstream's item and label
                        models (their guards are retired), styled in hsg-theme.css.</desc>
                    <param name="subtype" value="if (@subtype) then @subtype else 'generic'"/>
                    <param name="rendclass" value="replace(@rendition, '#', 'document_')"/>
                    <param name="content" value="*"/>
                    <pb:template xml:space="preserve"><ul xmlns="" class="description subtype-[[subtype]] [[rendclass]]">[[content]]</ul></pb:template>
                </model>
                <model behaviour="pass-through" predicate="ext:get-division-subtype(.) eq 'index'">
                    <desc>Upstream's index-division lists: entries render as their own
                        blocks (upstream's item model, cssClass "list"), not bullets.</desc>
                    <param name="content" value="tei:item"/>
                </model>
                <model predicate="tei:label" behaviour="list" cssClass="frus-labeled-list">
                    <param name="content" value="tei:item"/>
                </model>
                <model behaviour="list" useSourceRendition="true">
                    <param name="content" value="child::node()"/>
                </model>
            </elementSpec>
            <elementSpec ident="ref" mode="change">
                <desc>FRUS cross-reference resolution (PR #32 review: "BL-5 / BL-15 anchors do
                    not resolve"). Reference parity with hsg-shell's pmf:ref (ext-html.xql). The
                    corpus encodes three link conventions that the base teipublisher.odd ref model
                    renders as dead hrefs, because it emits @target verbatim:
                    "#bl_d5" (27,826 refs) points at another division of the same volume, not an
                    anchor on the current page (zero same-file targets exist corpus-wide; in the
                    per-division v2 data the target is a different file, so a bare fragment goes
                    nowhere); "frus1977-80v26#d271" (175, mostly footnotes) points into another
                    volume; "frus1958-60v10p2" (80) at another volume's landing page. Each becomes
                    an app URL under /historicaldocuments/. The volume id for same-volume refs
                    comes from global:volume-id, which reads it off the collection path (see the
                    graphic elementSpec on why not the teiHeader); it is empty outside the FRUS
                    collection, which is what scopes these three models to it.
                    Other collections keep the base
                    behaviour via the copied fallback models below (including the base
                    correspondence models, which deployed data still matches). http/mailto targets
                    do not match the predicates and fall through verbatim.</desc>
                <model predicate="@subtype='placeholder'" behaviour="pass-through">
                    <desc>placeholder for unavailable next/prev links</desc>
                    <param name="type" value="if (@type='prev') then 'previous' else @type"/>
                    <param name="svg" value="$parameters?context-path || '/resources/css/correspondence-icons.svg'"/>
                    <pb:template xmlns="" xml:space="preserve"><li class="unavailable">
                                <pb-i18n key="odd.nav-[[type]].before"/>
                                <svg class="icon">
                                <use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="[[svg]]#[[type]]"/>
                                </svg>
                                <pb-i18n key="odd.nav-[[type]].after"/>
                            </li></pb:template>
                </model>
                <model predicate="parent::correspContext and @type" behaviour="pass-through">
                    <desc>refs inside the correspContext are interpreted as links for next/previous elements in the corpus (copied from the base spec unchanged)</desc>
                    <param name="type" value="if (@type='prev') then 'previous' else @type"/>
                    <param name="target" value="@target"/>
                    <param name="svg" value="$parameters?context-path || '/resources/css/correspondence-icons.svg'"/>
                    <pb:template xmlns="" xml:space="preserve"><li><pb-popover>
                            <a href="[[target]]" emit="transcription" subscribe="transcription" slot="default">
                                <pb-i18n key="odd.nav-[[type]].before"/>
                                <svg class="icon">
                                <use xmlns:xlink="http://www.w3.org/1999/xlink" xlink:href="[[svg]]#[[type]]"/>
                                </svg>
                                <pb-i18n key="odd.nav-[[type]].after"/>
                            </a>
                            <template slot="alternate"><pb-i18n key="odd.[[type]]"/>:  [[ content ]]</template>
            </pb-popover></li></pb:template>
                </model>
                <model predicate="global:volume-id($parameters, .) != '' and starts-with(@target, 'frus') and contains(@target, '#')" behaviour="link">
                    <param name="uri" value="$parameters?context-path || '/historicaldocuments/' || substring-before(@target, '#') || '/' || substring-after(@target, '#')"/>
                </model>
                <model predicate="global:volume-id($parameters, .) != '' and starts-with(@target, 'frus')" behaviour="link">
                    <param name="uri" value="$parameters?context-path || '/historicaldocuments/' || @target"/>
                </model>
                <model predicate="global:volume-id($parameters, .) != '' and starts-with(@target, '#')" behaviour="link">
                    <param name="uri" value="$parameters?context-path || '/historicaldocuments/' || global:volume-id($parameters, .) || '/' || substring-after(@target, '#')"/>
                </model>
                <model predicate="contains(base-uri(root(.)), '/data/content/') and not(matches(@target, '^([a-z][a-z0-9+.-]*:|#|/)'))" behaviour="link">
                    <desc>App-internal links in the app-owned content pages
                        (data/content, OP#1313): targets are app-root-relative
                        (no scheme, no leading slash, no fragment), resolved
                        against the context path. Absolute http/mailto targets
                        fall through to the verbatim model below.</desc>
                    <param name="uri" value="$parameters?context-path || '/' || @target"/>
                </model>
                <model predicate="@target" behaviour="link">
                    <param name="uri" value="@target"/>
                </model>
                <model behaviour="inline"/>
            </elementSpec>
            <elementSpec ident="table" mode="change">
                <desc>PR #32 review audit: the base teipublisher.odd table/row/cell models drop
                    @rendition, so FRUS table renditions (cell-border-*, #middle, cell-num etc.,
                    from frus-encodingDesc.xml) rendered unstyled -- e.g. frus1861 d180's
                    attachment tables lost their vertical-align and border cells. Reference parity
                    with hsg-shell's frus.odd, whose whole table family carries
                    useSourceRendition. Like shell, a table containing renditions renders plain
                    (the renditions carry the styling); one without gets the design system's
                    default table dress (usa-table here, bootstrap there).</desc>
                <model predicate=".//row/@rendition or .//cell/@rendition" behaviour="table" useSourceRendition="true"/>
                <model behaviour="table" useSourceRendition="true" cssClass="usa-table"/>
            </elementSpec>
            <elementSpec ident="row" mode="change">
                <desc>See the table elementSpec above: keep source renditions.</desc>
                <model predicate="@role='label'" behaviour="row" cssClass="row-label" useSourceRendition="true"/>
                <model behaviour="row" useSourceRendition="true"/>
            </elementSpec>
            <elementSpec ident="cell" mode="change">
                <desc>See the table elementSpec above: keep source renditions.</desc>
                <model behaviour="cell" useSourceRendition="true"/>
            </elementSpec>
            <elementSpec ident="gap" mode="change">
                <desc>Reference parity with hsg-shell's frus.odd: a gap is rendered (as an
                    ellipsis with extent) only when it is quantifiable (@unit plus an integer
                    @quantity); anything else -- the corpus has e.g. a bare gap
                    reason="deleted" -- is omitted, where the base ODD's fallback rendered an
                    empty inline span.</desc>
                <model predicate="exists(@unit) and @quantity castable as xs:integer" behaviour="gap">
                    <param name="unit" value="@unit"/>
                    <param name="quantity" value="@quantity cast as xs:integer"/>
                </model>
                <model behaviour="omit"/>
            </elementSpec>
            <elementSpec ident="pb" mode="change">
                <desc>Reference parity with hsg-shell's frus.odd pb model: the visible text of a
                    page-break facsimile link is "[Page N]", not the bare page number -- the base
                    teipublisher.odd renders just @n, which reads as stray text in the prose (a
                    lone "66" before a section heading, PR #32 review). Same model chain as the
                    base spec (print omit, then the @facs IIIF webcomponent, then the no-facsimile
                    fallback), with only the visible content changed and an hsg-facs-link class
                    added for the grey right-floated margin styling (resources/css/hsg-theme.css;
                    shell equivalent: hsg-facsilime-link). The base spec's title-mode,
                    pb-facsimile-viewer and static-site variants are dropped: this app renders pb
                    only through page:transform document/division views, which pass none of those
                    parameters. The marker is a plain link to the page's facsimile view at
                    pg_{n} (OP#1335, hsg-shell pmf:pb-link parity): a relative href, resolved
                    against the document's own /historicaldocuments/{volume}/{division} URL --
                    the same technique hsg-shell used, and pbs render on no other page. The
                    legacy URL uses @n, not the v2 data's underscore-less @xml:id (and the
                    id-less continuation pb at a fragment start has only @n anyway);
                    hsgapi:view-facsimile translates back. Not a pb-facs-link webcomponent: that
                    renders href="javascript:;" and can only message a pb-facsimile on the same
                    page, and the users' expectation (and the reference behaviour) is navigation
                    to the standalone facsimile page. The predicate asks for a resolvable scan
                    (global:iiif-facs-id) so pages without images keep the plain label
                    fallback.</desc>
                <model output="print" behaviour="omit"/>
                <model predicate="@n and exists(global:iiif-facs-id($parameters, .))" behaviour="link" cssClass="facs pb hsg-facs-link">
                    <param name="content" value="'[Page ' || @n || ']'"/>
                    <param name="uri" value="'pg_' || @n"/>
                </model>
                <model behaviour="break" cssClass="pb hsg-facs-link" useSourceRendition="true">
                    <desc>Output Page label when no facsimile information is available</desc>
                    <param name="type" value="'page'"/>
                    <param name="label" value="'[Page ' || @n || ']'"/>
                </model>
            </elementSpec></schemaSpec>
        </body>
    </text></TEI>